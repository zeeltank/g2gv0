# MCP client/server
MCP_SERVER_URL=http://127.0.0.1:3400
MCP_PORT=3400

# Database connection used by the standalone MCP server
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_CONNECTION_LIMIT=25
DB_ACQUIRE_TIMEOUT=15000
DB_CONNECT_TIMEOUT=15000
DB_SOCKET_PATH=
DB_HEALTHCHECK_STRICT=false

# AI Stack chat. Without NEXT_PUBLIC_MODULE_CHAT_ENABLED=true the shell chat answers from the generic Next route and
# does NOT read the open module's own database records; with it, every module (including ones added later) is grounded
# on its own tables. The lifecycle/approval flags need AI_LIFECYCLE_ENABLED / AI_CHAT_ACTION_APPROVALS in hp_erp's .env.
NEXT_PUBLIC_MODULE_CHAT_ENABLED=true
NEXT_PUBLIC_CHAT_LIFECYCLE_ENABLED=true
NEXT_PUBLIC_CHAT_ACTION_APPROVALS=false
