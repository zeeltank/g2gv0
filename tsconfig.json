{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/ui/*": [
        "./components/ui/*"
      ],
      "@/components/*": [
        "./components/*"
      ],
      "@/domain/*": [
        "./components/domain/*"
      ],
      "@/shared/*": [
        "./components/shared/*"
      ],
      "@/services/*": [
        "./services/*"
      ],
      "@/lib/*": [
        "./lib/*"
      ],
      "@shared/conversational-ai-core": [
        "./packages/conversational-ai-core/src/index.ts"
      ],
      "@shared/conversational-ai-core/*": [
        "./packages/conversational-ai-core/src/*"
      ],
      "@shared/conversational-mcp-core": [
        "./packages/conversational-mcp-core/src/index.ts"
      ],
      "@shared/conversational-mcp-core/*": [
        "./packages/conversational-mcp-core/src/*"
      ],
      "@/hooks/*": [
        "./hooks/*"
      ],
      "@/types/*": [
        "./types/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
